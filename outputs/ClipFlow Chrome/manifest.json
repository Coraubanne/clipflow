{
  "manifest_version": 3,
  "name": "ClipFlow",
  "version": "2.8.7",
  "description": "Détecte les vidéos de l’onglet actif et les envoie simplement vers ClipFlow.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.tf1.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ClipFlow · vidéos de cette page",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
