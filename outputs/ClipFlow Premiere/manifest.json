{
  "manifestVersion": 5,
  "id": "fr.clipflow.premiere.bridge",
  "name": "ClipFlow",
  "shortname": "ClipFlow",
  "version": "1.0.4",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "clipflowBridge",
      "label": {
        "default": "ClipFlow"
      },
      "minimumSize": {
        "width": 220,
        "height": 110
      },
      "maximumSize": {
        "width": 900,
        "height": 500
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 130
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 150
      }
    }
  ]
}
