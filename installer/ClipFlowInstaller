#!/bin/zsh
set -euo pipefail

resource_dir="${0:A:h:h}/Resources"
payload_dir="${resource_dir}/Payload"
source_app="${payload_dir}/ClipFlow.app"
source_extension="${payload_dir}/ClipFlow Chrome"
source_premiere="${payload_dir}/ClipFlow Premiere"
target_app="/Applications/ClipFlow.app"
extension_root="${HOME}/Documents/ClipFlow"
target_extension="${extension_root}/ClipFlow Chrome"
premiere_version="$(/usr/bin/sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${source_premiere}/manifest.json" | /usr/bin/head -n 1)"
target_premiere="${HOME}/Library/Application Support/Adobe/UXP/Plugins/External/fr.clipflow.premiere.bridge_${premiere_version}"
native_manifest_dir="${HOME}/Library/Application Support/Google/Chrome/NativeMessagingHosts"
native_manifest="${native_manifest_dir}/fr.tubesave.chrome.json"
backup_app="/Applications/.ClipFlow.backup.$$"

show_error() {
  /usr/bin/osascript -e 'display alert "Installation impossible" message "ClipFlow n’a pas pu être installé. Vérifiez que ce programme se trouve toujours dans son image disque, puis réessayez." as critical buttons {"OK"} default button "OK"' >/dev/null
}

for required in "${source_app}" "${source_extension}" "${source_premiere}"; do
  if [[ ! -e "${required}" ]]; then
    show_error
    exit 1
  fi
done

restore_previous_app() {
  if [[ -d "${backup_app}" && ! -e "${target_app}" ]]; then
    /bin/mv "${backup_app}" "${target_app}" || true
  fi
}
trap restore_previous_app EXIT

if [[ -e "${backup_app}" ]]; then
  /bin/rm -rf "${backup_app}"
fi
if [[ -e "${target_app}" ]]; then
  /bin/mv "${target_app}" "${backup_app}"
fi
if ! /usr/bin/ditto "${source_app}" "${target_app}"; then
  /bin/rm -rf "${target_app}"
  show_error
  exit 1
fi
/bin/rm -rf "${backup_app}"

/bin/mkdir -p "${extension_root}"
/bin/rm -rf "${target_extension}"
/usr/bin/ditto "${source_extension}" "${target_extension}"

/bin/mkdir -p "${target_premiere:h}"
/bin/rm -rf "${target_premiere}"
/usr/bin/ditto "${source_premiere}" "${target_premiere}"

/bin/mkdir -p "${native_manifest_dir}"
/usr/bin/printf '%s\n' \
  '{' \
  '  "name": "fr.tubesave.chrome",' \
  '  "description": "Liaison locale entre Chrome et ClipFlow",' \
  '  "path": "/Applications/ClipFlow.app/Contents/Resources/ytdlp/native_host",' \
  '  "type": "stdio",' \
  '  "allowed_origins": [' \
  '    "chrome-extension://emfjpphkcgnjldilcnieaoppmfpfkhfg/"' \
  '  ]' \
  '}' > "${native_manifest}"

/usr/bin/open -g "${target_app}" >/dev/null 2>&1 || true

choice="$(/usr/bin/osascript <<'APPLESCRIPT'
display dialog "ClipFlow est installé.\n\nUne dernière étape dans Chrome : activez le mode développeur, cliquez sur « Charger l’extension non empaquetée », puis choisissez le dossier ClipFlow Chrome qui va s’afficher." buttons {"Plus tard", "Ouvrir Chrome"} default button "Ouvrir Chrome" with title "Installation terminée" with icon note
button returned of result
APPLESCRIPT
)"

if [[ "${choice}" == "Ouvrir Chrome" ]]; then
  /usr/bin/open -a "Google Chrome" "chrome://extensions" >/dev/null 2>&1 || true
  /usr/bin/open -R "${target_extension}" >/dev/null 2>&1 || true
fi

exit 0
